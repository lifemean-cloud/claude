# ------------------------------------------------------------
# 스킬 설치 도구가 만든 바로가기(Junction) 폴더
# 원본은 .agents/skills/ 에 있으므로 중복으로 올리지 않습니다.
# ------------------------------------------------------------

# .claude/skills 는 바로가기만 숨기고, 직접 넣은 진짜 스킬은 예외로 올립니다.
# (바로가기는 git 심볼릭 링크로 따로 등록되어 있어 GitHub·웹에서도 스킬이 보입니다)
/.claude/skills/*
!/.claude/skills/ui-ux-pro-max/
# Superpowers 스킬 (obra/superpowers v7.0.0, MIT) — 웹·클라우드에서는 플러그인이 안 깔리므로 복사본 사용
!/.claude/skills/brainstorming/
!/.claude/skills/executing-plans/
!/.claude/skills/systematic-debugging/
!/.claude/skills/verification-before-completion/
!/.claude/skills/writing-plans/
!/.claude/skills/writing-skills/

# graphify (코드 지도 도구) — 이 PC 전용. 훅은 .claude/settings.local.json 에 있음
*.graphify-bak
/graphify-out/
/CLAUDE.md
/.claude/CLAUDE.md

/skills/
/data/

